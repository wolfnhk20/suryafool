# Suryafool — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.

# ── LLM Providers (Nemotron 3 Ultra via OpenAI-compatible endpoints) ────────────
# Primary: OpenRouter
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Fallback: OpenCode Zen (has had recent reliability issues)
# Get your key at: https://opencode.ai
OPENCODE_API_KEY=

# ── Rate limiting ───────────────────────────────────────────────────────────────
# Maximum LLM requests per minute across all agents (sliding window).
# Default: 32
SURYAFOOL_RATE_LIMIT=32

# ── Bootstrap Agent ────────────────────────────────────────────────────────────
# Path to the dependency manifest. Defaults to bootstrap/manifest.yaml.
# SURYAFOOL_MANIFEST_PATH=bootstrap/manifest.yaml

# ── Hardware / USB passthrough (Windows only) ──────────────────────────────────
# Bus ID of your wireless adapter as reported by `usbipd list`.
# Example: 1-4
# SURYAFOOL_USB_BUSID=

# ── Logging ────────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
# Default: INFO
SURYAFOOL_LOG_LEVEL=INFO

# ── Lab Mode (security research) ───────────────────────────────────────────────
# Comma-separated list of authorized target identifiers (MAC, BSSID, etc.)
# Only devices listed here may be actively interacted with in Lab Mode.
# Example: AA:BB:CC:DD:EE:FF,11:22:33:44:55:66
# SURYAFOOL_LAB_TARGETS=