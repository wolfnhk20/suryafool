# Suryafool — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.

# ── LLM Provider Selection ─────────────────────────────────────────────────────
# Which LLM provider to use. Options: nim | groq
# Default: nim
SURYAFOOL_LLM_PROVIDER=nim

# ── NVIDIA NIM (primary provider) ──────────────────────────────────────────────
# Get your key at: https://build.nvidia.com
NVIDIA_API_KEY=
# ── Groq (fallback provider) ───────────────────────────────────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=

# ── Bootstrap Agent ────────────────────────────────────────────────────────────
# Path to the dependency manifest. Defaults to bootstrap/manifest.yaml.
# SURYAFOOL_MANIFEST_PATH=bootstrap/manifest.yaml

# ── Hardware / USB passthrough (Windows only) ──────────────────────────────────
# Bus ID of your wireless adapter as reported by `usbipd list`.
# Example: 1-4
# SURYAFOOL_USB_BUSID=

# ── Logging ────────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
# Default: INFO
SURYAFOOL_LOG_LEVEL=INFO

# ── Lab Mode (security research) ───────────────────────────────────────────────
# Comma-separated list of authorized target identifiers (MAC, BSSID, etc.)
# Only devices listed here may be actively interacted with in Lab Mode.
# Example: AA:BB:CC:DD:EE:FF,11:22:33:44:55:66
# SURYAFOOL_LAB_TARGETS=
