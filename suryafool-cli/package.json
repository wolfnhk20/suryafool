{
  "name": "suryafool",
  "type": "module",
  "version": "0.1.0",
  "description": "Universal agentic wireless platform — cyberpunk CLI",
  "main": "dist/index.mjs",
  "bin": {
    "suryafool": "./bin/suryafool.js"
  },
  "scripts": {
    "build": "esbuild src/app.js --bundle --platform=node --outfile=dist/index.mjs --loader:.js=jsx --format=esm --external:react --external:react-devtools-core --external:ink --external:ink-text-input --external:ink-box --external:ink-gradient --external:chalk --external:gradient-string --external:yargs --external:adm-zip",
    "dev": "node src/app.js",
    "postinstall": "node scripts/fetch-binary.cjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "wireless",
    "security",
    "agentic",
    "cyberpunk",
    "cli"
  ],
  "author": "",
  "license": "MIT",
    "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@pppp606/ink-chart": "0.2.0",
    "adm-zip": "^0.5.10",
    "chalk": "^4.1.2",
    "fullscreen-ink": "^0.1.0",
    "gradient-string": "^2.0.2",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "yargs": "^17.7.2"
  },
    "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.0",
    "ink-testing-library": "^4.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
