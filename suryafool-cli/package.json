{
  "name": "suryafool",
  "type": "module",
  "version": "0.1.0",
  "description": "Universal agentic wireless platform — cyberpunk CLI",
  "main": "dist/index.mjs",
  "bin": {
    "suryafool": "./bin/suryafool.js"
  },
  "scripts": {
    "build": "esbuild src/app.js --bundle --platform=node --outfile=dist/index.mjs --loader:.js=jsx --format=esm --external:react --external:react-devtools-core --external:ink --external:ink-text-input --external:ink-box --external:ink-gradient --external:chalk --external:gradient-string --external:yargs --external:adm-zip",
    "dev": "node src/app.js",
    "postinstall": "node scripts/fetch-binary.cjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "wireless",
    "security",
    "agentic",
    "cyberpunk",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.10",
    "chalk": "^4.1.2",
    "gradient-string": "^2.0.2",
    "ink": "^4.4.1",
    "ink-box": "^2.0.0",
    "ink-text-input": "^5.0.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "esbuild": "^0.20.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
